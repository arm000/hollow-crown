{
  "name": "the-hollow-crown",
  "version": "0.1.0",
  "description": "A first-person grid-based dungeon crawler in the style of Legend of Grimrock",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:web": "npm run build && cd dist && zip -r ../hollow-crown-web.zip . -x '.*' && cd .."
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
